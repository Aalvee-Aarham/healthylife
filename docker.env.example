# Copy to `.env` at the repo root and adjust as needed, then run:
#   docker compose up --build
#
# `.env` here is read by docker-compose itself (via ${VAR} interpolation),
# not by the Laravel app directly.

# Generate with: php packages/backend/artisan key:generate --show
# Leave empty to have the backend generate one on first boot (not persisted
# across rebuilds unless you copy it back here).
APP_KEY=

DB_DATABASE=healthylife
DB_USERNAME=postgres
DB_PASSWORD=postgres

AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
