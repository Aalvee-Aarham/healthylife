{
  "name": "healthy-life-v1",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace @healthy-life/frontend",
    "dev:backend": "php packages/backend/artisan serve --host=0.0.0.0 --port=8000",
    "build": "npm run build --workspace @healthy-life/frontend",
    "lint": "npm run lint --workspace @healthy-life/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
