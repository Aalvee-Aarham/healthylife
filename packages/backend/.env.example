APP_NAME=HealthyLife
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=healthylife
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# AI provider abstraction — switch between groq and gemini without code changes
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: absolute path to cacert.pem if PHP's curl.cainfo isn't set (fixes "cURL error 60" on Windows)
AI_HTTP_CA_BUNDLE=
